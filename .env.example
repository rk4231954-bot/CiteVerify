# Production (Railway) settings: docs/deploy-railway.md

# ─── Database ────────────────────────────────────────────────
# Development: a SQLite file. Relative paths resolve inside packages/database.
# Production: a PostgreSQL URL (postgres://...), set on the host. Never commit it.
DATABASE_URL="file:./dev.db"
# Optional: sqlite | postgresql. Inferred from DATABASE_URL when unset.
# DATABASE_PROVIDER=
# Optional: max pooled PostgreSQL connections per API instance (default 10)
# DATABASE_POOL_MAX=

# ─── API server ──────────────────────────────────────────────
# PORT (injected by Railway and most hosts) takes precedence over API_PORT.
API_PORT=3001
# HOST=0.0.0.0
# Allowed CORS origin(s), comma-separated. One "*" inside the first host label
# matches preview URLs, e.g. https://citeverify-*-team.vercel.app.
# Production requires public https origins.
FRONTEND_URL="http://localhost:5173"

# ─── Auth ────────────────────────────────────────────────────
# REQUIRED, min 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=
# Token lifetime in seconds (default 7 days)
JWT_EXPIRES_IN=604800

# ─── Uploads ─────────────────────────────────────────────────
# Relative paths resolve against the repo root (development).
# Production: an absolute path on a persistent volume; defaults to
# $RAILWAY_VOLUME_MOUNT_PATH/uploads when a Railway volume is attached.
UPLOAD_DIR="storage/uploads"
# Max upload size in bytes (default 10 MB)
MAX_FILE_SIZE=10485760

# Publication retrieval (Crossref + OpenAlex; both work without credentials)
# Contact email for the providers' polite pools — recommended, never committed
PUBLICATION_CONTACT_EMAIL=
# Optional OpenAlex API key
OPENALEX_API_KEY=
PUBLICATION_RETRIEVAL_TIMEOUT_MS=10000

# Evidence extraction: only open-access PDFs reported by OpenAlex are fetched
# (no paywall bypassing, no landing-page scraping). Set to false to use abstracts only.
EVIDENCE_FULLTEXT_ENABLED=true
EVIDENCE_FULLTEXT_TIMEOUT_MS=20000
EVIDENCE_FULLTEXT_MAX_BYTES=15728640

# ─── Web app ─────────────────────────────────────────────────
# Vite reads this from apps/web/.env(.local) or the hosting environment
# (e.g. Vercel project settings), not from this file.
# Development: leave unset; the Vite dev server proxies /api to API_PORT.
# Production builds REQUIRE it (the API origin; a trailing /api is accepted).
# Public value: it is embedded in the browser bundle. Never put secrets in VITE_* variables.
# VITE_API_BASE_URL="https://api.example.com"
