{
  "name": "@citeverify/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --packages=external --outdir dist",
    "start": "bun --env-file=../../.env dist/index.js",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@citeverify/database": "workspace:*",
    "@citeverify/shared": "workspace:*",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@citeverify/config": "workspace:*",
    "@types/bun": "^1.4.4"
  }
}
